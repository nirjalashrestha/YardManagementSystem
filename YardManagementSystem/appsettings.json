{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Jwt": {
    "Key": "your_jwt_key_here",
    "Issuer": "your_issuer",
    "Audience": "your_audience"
  },

  "ConnectionStrings": {
    "DefaultConnection": "your_connection_string_here"
  },

