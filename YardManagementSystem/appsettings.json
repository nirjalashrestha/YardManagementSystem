  },

  "SeedAdmin": {
    "Email": "admin@example.com",
    "Password": "your_password_here"
  },

  "OpenAI": {
    "ApiKey": "your_openai_api_key_here",
    "Model": "gpt-4o-mini"
  },

  "AllowedHosts": "*"
